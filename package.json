{
  "name": "system-friction-terminal",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "sfi:seed": "tsx scripts/bootstrap-sfi-cognitive-seed.ts",
    "dev": "next dev --webpack",
    "dev:local-insecure": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:NODE_TLS_REJECT_UNAUTHORIZED='0'; $env:SFI_ALLOW_INSECURE_LOCAL_TLS='true'; Get-Content .env.local | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2], 'Process') } }; next dev\"",
    "postinstall": "node scripts/materialize-spatial-assets.mjs",
    "prebuild": "node scripts/materialize-spatial-assets.mjs",
    "build": "npm run qa:sfi-research-metadata && npm run qa:sfi-bilingual-interface && npm run qa:sfi-web-source-extraction && npm run qa:sfi-resume-identity && npm run qa:sfi-spatial-surfaces && npm run qa:sfi-studio-hygiene && node scripts/merge-openapi-cases.mjs && node scripts/merge-openapi-universal-cycle.mjs && node scripts/merge-openapi-person-ct.mjs && npx tsx scripts/qa-sfi-case-gpt-bridge.ts && npm run qa:sfi-ingestion-boundary && npm run qa:sfi-universal-cycle && npm run qa:sfi-learning-bootstrap && npm run qa:sfi-person-ct-patterns && npm run qa:sfi-mutation-evidence && npm run qa:sfi-agent-execution-contract && next build",
    "build:local-insecure": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:NODE_TLS_REJECT_UNAUTHORIZED='0'; $env:SFI_ALLOW_INSECURE_LOCAL_TLS='true'; Get-Content .env.local | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2], 'Process') } }; next build\"",
    "start": "next start",
    "lint": "next lint",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit:dead-components": "node scripts/find-dead-components.mjs",
    "preflight:runtime": "node scripts/runtime-preflight.mjs",
    "check:boundaries": "node scripts/check-domain-boundaries.mjs",
    "qa:sfi-runtime": "node scripts/qa-sfi-runtime.mjs",
    "qa:sfi-convergence": "node scripts/qa-sfi-convergence.mjs",
    "qa:sfi-execution": "node scripts/qa-sfi-execution.js",
    "qa:sfi-agent-execution-contract": "tsx scripts/qa-sfi-agent-execution-contract.ts",
    "qa:sfi-core-runtime": "tsx scripts/qa-sfi-core-runtime.ts",
    "qa:sfi-institutional-contracts": "node --import tsx --test src/lib/contracts/institutionalContracts.test.ts",
    "qa:sfi-ct-decision-transfer": "node --import tsx --test src/core/cognitive-twin/reentry/decisionTransfer.test.ts",
    "qa:sfi-entity-graph": "tsx scripts/qa-sfi-entity-graph.ts",
    "qa:sfi-entity-view": "tsx scripts/qa-sfi-entity-view.ts",
    "qa:sfi-entity-navigation": "tsx scripts/qa-sfi-entity-navigation.ts",
    "qa:sfi-connected-entity": "tsx scripts/qa-sfi-connected-entity.ts",
    "qa:sfi-entity-linkage": "tsx scripts/audit-sfi-entity-linkage.ts",
    "qa:sfi-spatial-surfaces": "tsx scripts/qa-sfi-spatial-surfaces.ts",
    "qa:sfi-ingestion-boundary": "tsx scripts/qa-sfi-ingestion-epistemic-boundary.ts",
    "qa:sfi-universal-cycle": "tsx scripts/qa-sfi-universal-full-cycle.ts",
    "qa:sfi-resume-identity": "tsx scripts/qa-sfi-resume-identity.ts",
    "qa:sfi-learning-bootstrap": "tsx scripts/qa-sfi-learning-bootstrap.ts",
    "qa:sfi-person-ct-patterns": "tsx scripts/qa-sfi-person-ct-patterns.ts",
    "qa:sfi-mutation-evidence": "tsx scripts/qa-sfi-mutation-evidence.ts",
    "qa:sfi-bilingual-interface": "tsx scripts/qa-sfi-bilingual-interface.ts",
    "qa:sfi-web-source-extraction": "tsx scripts/qa-sfi-web-source-extraction.ts",
    "qa:sfi-research-metadata": "node scripts/qa-sfi-research-metadata.mjs",
    "qa:studio-audio": "node scripts/studio-audio-engine-smoke.cjs",
    "qa:sfi-studio-capability-inventory": "tsx scripts/qa-sfi-studio-capability-inventory.ts",
    "qa:sfi-studio-loudness": "tsx scripts/qa-sfi-studio-loudness.ts",
    "qa:sfi-studio-rhythm": "tsx scripts/qa-sfi-studio-rhythm.ts",
    "qa:sfi-studio-harmony": "tsx scripts/qa-sfi-studio-harmony.ts",
    "qa:sfi-studio-workspace": "tsx scripts/qa-sfi-studio-workspace.ts",
    "qa:sfi-studio-cognitive": "tsx scripts/qa-sfi-studio-cognitive.ts && npm run qa:fi001-autonomy && npm run qa:fi001-oidc",
    "qa:sfi-studio-hygiene": "tsx scripts/qa-sfi-studio-hygiene.ts",
    "qa:fi001-autonomy": "tsx scripts/qa-fi001-autonomy.ts",
    "qa:fi001-oidc": "tsx scripts/qa-fi001-oidc-policy.ts",
    "qa:sfi-root-capability-matrix": "tsx scripts/qa-sfi-root-capability-matrix.ts",
    "qa:sfi-operating-field": "tsx scripts/qa-sfi-operating-field-closure.ts",
    "qa:sfi-operational-reset": "tsx scripts/qa-sfi-operational-reset.ts",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "phase:verify": "npm run check:boundaries && npm run typecheck",
    "qa:sfi-pipeline": "node scripts/qa-sfi-minimal-pipeline.mjs",
    "repair:mojibake": "node scripts/repair-mojibake.mjs",
    "db:export": "node scripts/db/export-supabase.mjs",
    "db:inventory": "node scripts/db/inventory-supabase.mjs",
    "db:cleanup:plan": "node scripts/db/prepare-institutional-cleanup.mjs",
    "db:proof:export": "node scripts/db/export-sfi-full-cycle-proof.mjs",
    "db:snapshot:evidence": "node scripts/db/create-db-evidence-snapshot.mjs",
    "db:retire:unconsumed:safe": "node scripts/db/run-retirement-with-snapshot.mjs",
    "db:reset:sfi": "node scripts/db/reset-sfi-operational-tables.mjs",
    "db:seed:sfi": "node scripts/db/seed-sfi-canonical-history.mjs",
    "db:verify:sfi": "node scripts/db/verify-sfi-database.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.0.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.105.4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "music-metadata": "^11.13.0",
    "next": "^16.3.3",
    "pdf-parse": "^2.4.5",
    "pixi.js": "^8.19.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3",
    "stripe": "^22.1.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.26",
    "supabase": "^2.116.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
